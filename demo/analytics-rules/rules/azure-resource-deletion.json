{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "id": "5e808b52-9bd2-4db0-a51c-bf8395cd5521",
  "kind": "Scheduled",
  "properties": {
    "displayName": "[PROD] Successful Azure resource deletion",
    "description": "Detects successful Azure resource deletion operations. This generic demo rule is deployed from GitHub and is disabled by default.",
    "severity": "Medium",
    "enabled": false,
    "query": "AzureActivity\n| where OperationNameValue endswith \"/delete\"\n| where ActivityStatusValue =~ \"Success\"\n| project TimeGenerated, Caller, CallerIpAddress, ResourceGroup, _ResourceId, OperationNameValue",
    "queryFrequency": "PT1H",
    "queryPeriod": "PT1H",
    "triggerOperator": "GreaterThan",
    "triggerThreshold": 0,
    "suppressionDuration": "PT5H",
    "suppressionEnabled": false,
    "tactics": [
      "Impact"
    ],
    "techniques": [
      "T1485"
    ],
    "eventGroupingSettings": {
      "aggregationKind": "SingleAlert"
    },
    "entityMappings": [
      {
        "entityType": "IP",
        "fieldMappings": [
          {
            "identifier": "Address",
            "columnName": "CallerIpAddress"
          }
        ]
      }
    ]
  }
}
